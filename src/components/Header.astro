---
import { db, Venue } from "astro:db";

// Props for current filter state (passed from index.astro)
interface Props {
    currentVenue?: string;
    currentGenre?: string;
}

const { currentVenue = "", currentGenre = "" } = Astro.props;

// Fetch venues for dropdown
const venues = await db
    .select()
    .from(Venue)
    .where((v: any) => v.enabled);
---

<header
    class="h-12 px-4 flex items-center justify-between border-b-2 border-black bg-base-100"
>
    <a href="/" class="flex items-center h-full">
        <span
            class="logo-text text-2xl uppercase tracking-tighter hover:opacity-80 transition-opacity"
            >the week ahead</span
        >
    </a>

    <!-- Filters (Tablet & Desktop) -->
    <form
        action="/"
        method="GET"
        class="hidden sm:flex items-center gap-1.5 sm:gap-2"
    >
        <select
            id="venue-select"
            name="venue"
            class="select select-bordered select-sm w-28 sm:w-32 md:w-40"
        >
            <option value="">All Venues</option>
            {
                venues.map((v) => (
                    <option value={v.id} selected={currentVenue === v.id}>
                        {v.name}
                    </option>
                ))
            }
        </select>

        <select
            id="genre-select"
            name="genre"
            class="select select-bordered select-sm w-24 sm:w-28 md:w-32"
        >
            <option value="">All Genres</option>
            <option value="music" selected={currentGenre === "music"}
                >Music</option
            >
            <option value="film" selected={currentGenre === "film"}>Film</option
            >
            <option value="comedy" selected={currentGenre === "comedy"}
                >Comedy</option
            >
            <option value="other" selected={currentGenre === "other"}
                >Other</option
            >
        </select>

        <!-- RSS Link -->
        <a class="btn btn-sm btn-outline" href="/api/rss.xml" target="_blank">
            RSS
        </a>
    </form>

    <!-- Mobile Filter Button -->
    <button id="mobile-filter-btn" class="btn btn-sm btn-ghost sm:hidden">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"
            ></path>
        </svg>
    </button>

    <!-- Add a Venue (Desktop only) -->
    <a
        href="mailto:hello@theweekahead.ca?subject=Add%20a%20Venue"
        class="btn btn-outline btn-sm hidden md:inline-flex"
    >
        Add a Venue
    </a>
</header>

<script>
    // --- Mobile Menu Toggle ---
    const btn = document.getElementById("mobile-filter-btn");
    const form = document.querySelector("form") as HTMLFormElement;

    btn?.addEventListener("click", () => {
        if (form) {
            form.classList.toggle("hidden");
            form.classList.toggle("flex");
            form.classList.toggle("absolute");
            form.classList.toggle("top-12");
            form.classList.toggle("left-0");
            form.classList.toggle("w-full");
            form.classList.toggle("bg-base-100");
            form.classList.toggle("p-4");
            form.classList.toggle("flex-col");
            form.classList.toggle("border-b-2");
            form.classList.toggle("border-black");
            form.classList.toggle("z-50");
        }
    });

    // --- Client-Side Filtering ---
    const venueSelect = document.getElementById(
        "venue-select",
    ) as HTMLSelectElement;
    const genreSelect = document.getElementById(
        "genre-select",
    ) as HTMLSelectElement;

    // 1. Read URL on load to set initial state
    const params = new URLSearchParams(window.location.search);
    const initialVenue = params.get("venue") || "";
    const initialGenre = params.get("genre") || "";

    if (venueSelect) venueSelect.value = initialVenue;
    if (genreSelect) genreSelect.value = initialGenre;

    // 2. Perform the filtering of elements
    function filterEvents() {
        const venue = venueSelect?.value || "";
        const genre = genreSelect?.value || "";

        // Update URL state so links are shareable without reloading
        const newParams = new URLSearchParams();
        if (venue) newParams.set("venue", venue);
        if (genre) newParams.set("genre", genre);

        const newUrl =
            window.location.pathname +
            (newParams.toString() ? "?" + newParams.toString() : "");
        window.history.replaceState({}, "", newUrl);

        // Hide/Show event cards
        const cards = document.querySelectorAll(".event-card");
        cards.forEach((card) => {
            const el = card as HTMLElement;
            const cardVenue = el.dataset.venue || "";
            const cardGenre = el.dataset.genre || "";

            const matchVenue = !venue || cardVenue === venue;
            const matchGenre = !genre || cardGenre === genre;

            if (matchVenue && matchGenre) {
                el.style.display = ""; // restore default block display
            } else {
                el.style.display = "none";
            }
        });
    }

    // 3. Attach listeners and run initially
    venueSelect?.addEventListener("change", filterEvents);
    genreSelect?.addEventListener("change", filterEvents);

    // Run on initial load to catch direct link sharing
    filterEvents();
</script>
