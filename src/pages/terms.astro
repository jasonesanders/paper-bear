---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Terms & Conditions | Paper Bear">
    <main class="max-w-2xl mx-auto p-8">
        <h1 class="text-2xl font-bold mb-4">Terms & Conditions</h1>

        <p class="mb-4">
            Paper Bear is an unofficial event aggregator for Vancouver venues.
            We scrape publicly available event information and display it for
            convenience.
        </p>

        <h2 class="text-lg font-bold mt-6 mb-2">Disclaimer</h2>
        <p class="mb-4">
            Event information is provided "as is" without warranty. Always
            verify details with the official venue website before attending.
        </p>

        <h2 class="text-lg font-bold mt-6 mb-2">Data Sources</h2>
        <p class="mb-4">
            All event data is scraped from publicly accessible venue websites.
            We do not store personal information or require user accounts.
        </p>

        <h2 class="text-lg font-bold mt-6 mb-2">Contact</h2>
        <p>
            Questions? Reach out at <a
                href="mailto:contact@paperbear.dev"
                class="link">contact@paperbear.dev</a
            >.
        </p>
    </main>
</Layout>
