---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL || "/";
---

<Layout title="About Us | The Week Ahead">
    <main
        class="max-w-6xl mx-auto p-8 flex flex-col md:flex-row items-center gap-12"
    >
        <div class="flex-1">
            <h1 class="text-3xl font-bold mb-6">About Us</h1>

            <p class="mb-4 text-lg">
                The Week Ahead is your local-first event aggregator for
                Vancouver. We believe in the power of showing up. One you. One
                life. One week.
            </p>

            <p class="mb-4">
                We scour the city's best venues to bring you a clean,
                no-nonsense look at what's happening. No algorithms, no
                fluff—just the data you need to plan your next outing.
            </p>

            <h2 class="text-xl font-bold mt-8 mb-4">Disclaimer</h2>
            <p class="mb-6 opacity-70 italic">
                Event information is provided "as is". Always verify details
                with the official venue website before attending.
            </p>

            <h2 class="text-xl font-bold mt-8 mb-4">Contact</h2>
            <p>
                Questions? Collaborations? Reach out at <a
                    href="mailto:theweekahead@subversivelabs.ca"
                    class="link font-bold text-black"
                    >theweekahead@subversivelabs.ca</a
                >.
            </p>
        </div>

        <div
            class="flex-1 flex flex-col items-center justify-center gap-8 min-h-[400px]"
        >
            <img src={`${base}/pb.png`} alt="Logo Motif" class="w-48 h-auto" />
            <div class="relative w-full max-w-md aspect-[4/5]">
                <img
                    src={`${base}/pb-wall.png`}
                    alt="The Week Ahead Wall"
                    class="w-full h-full object-cover rounded-lg"
                    style="mask-image: radial-gradient(circle, black 40%, transparent 85%); webkit-mask-image: radial-gradient(circle, black 40%, transparent 85%);"
                />
            </div>
        </div>
    </main>
</Layout>
