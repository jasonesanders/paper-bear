---
import "@fontsource/oswald";
import "@fontsource/space-mono";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    currentVenue?: string;
    currentGenre?: string;
}

const {
    title = "Paper Bear",
    currentVenue = "",
    currentGenre = "",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="lofi">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
    </head>
    <body
        class="bg-base-100 text-base-content font-mono min-h-screen flex flex-col"
    >
        <Header currentVenue={currentVenue} currentGenre={currentGenre} />
        <div class="flex-1 flex flex-col">
            <slot />
        </div>
        <Footer />
    </body>
</html>
