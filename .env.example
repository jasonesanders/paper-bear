# Paper-Bear Environment Variables
# Copy this file to .env and fill in your values

# Jules API Key (Google Labs Coding Agent)
JULES_API_KEY=your_jules_api_key_here

# Scraper Configuration
SCRAPER_USER_AGENT=PaperBear/1.0 (Vancouver Community Events Bot; contact@paperbear.dev)
SCRAPER_DELAY_MS=1500

# Turso Production Database
ASTRO_DB_REMOTE_URL=libsql://your-db-name.turso.io
ASTRO_DB_APP_TOKEN=your_token_here
